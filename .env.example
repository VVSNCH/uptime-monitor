POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime_monitor

# Hosted Postgres usually needs ?sslmode=require on the end.
DATABASE_URL=postgresql://uptime:uptime@localhost:5432/uptime_monitor
# Connections per process. api and worker each hold their own pool, so the
# total is this times the number of running instances.
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# json in production; pretty is easier to read locally.
LOG_FORMAT=pretty
LOG_LEVEL=info

# Public entry point. Everything the browser calls goes through here.
GATEWAY_PORT=3000
WEB_ORIGIN=http://localhost:5000

# Internal services. The host is what they register under, so the gateway
# must be able to reach them at that address.
API_PORT=3001
API_HOST=localhost
WORKER_PORT=3002
WORKER_HOST=localhost

# Swagger UI at http://localhost:3000/api/docs. Turn off where the API is not public.
API_DOCS_ENABLED=true

VITE_API_URL=http://localhost:3000/api/v1

# Lets the worker check localhost and private-network URLs. Leave this off
# anywhere users can add monitors, or a monitor becomes a way into the network.
ALLOW_PRIVATE_TARGETS=false

# Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true anywhere served over https. lax works when the web app and the api share
# a site (app.example.com and api.example.com); separate sites need none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

# Integration tests truncate this database, so it must not be the one above.
# They refuse to run unless the name ends in _test.
TEST_DATABASE_URL=postgresql://uptime:uptime@localhost:5432/uptime_monitor_test

# How many checks one worker runs at the same time. A slow site holds one slot
# for up to its timeout, so this caps how much a few slow sites can delay the rest.
CHECK_CONCURRENCY=20

# Email alerts. Leave SMTP_URL empty to run without email; email channels then
# report that email is not set up. Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
ALERT_FROM_EMAIL=alerts@uptime.local
# Linked from every alert so it opens the right monitor.
APP_PUBLIC_URL=http://localhost:5000
